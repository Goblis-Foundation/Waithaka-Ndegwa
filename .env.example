# Inject through the process environment; this file is documentation, not auto-loaded.
APP_ENV=production
APP_READY=1
# Enable only on the intended production environment after reviewing pending work.
WORKER_ENABLED=0
APP_URL=https://www.waithakandegwa.com
APP_FORCE_CANONICAL=true
APP_ALLOWED_HOSTS=www.waithakandegwa.com,waithakandegwa.com,www.waithakandegwa.co.ke,waithakandegwa.co.ke
APP_TIMEZONE=Africa/Nairobi
# Preserve the original key with the restored database. Never generate a replacement for recovery.
APP_KEY=
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSL_CA=/var/app/current/deploy/aws/global-bundle.pem
SESSION_DRIVER=database
# Only actual proxy CIDRs allowed by your security groups; never 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
AWS_REGION=
MEDIA_DRIVER=s3
MEDIA_BUCKET=
MEDIA_PRIVATE_BUCKET=
MEDIA_PUBLIC_URL=https://www.waithakandegwa.com
# Keep disabled until identity, DKIM, production sending access and provider feedback are verified.
MAIL_TRANSPORT=disabled
MAIL_FROM=
MAIL_FROM_NAME=Waithaka Ndegwa
SES_REGION=
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=
MAIL_POSTAL_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
