{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Waithaka Ndegwa persistent data foundation. Deploy separately from the application. Restore live data before enabling application traffic.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "At least two private subnets in different availability zones"
    },
    "ApplicationSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id",
      "Description": "Only the application security group may reach the database"
    },
    "DatabaseName": {
      "Type": "String",
      "Default": "waithaka",
      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9]{0,62}"
    },
    "DatabaseClass": {
      "Type": "String",
      "Default": "db.t4g.small"
    },
    "MultiAZ": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "DatabaseEngineVersion": {
      "Type": "String",
      "Description": "An available, supported RDS MySQL 8.4 minor version in the chosen region; validate with describe-db-engine-versions before deployment"
    },
    "MediaDistributionArn": {
      "Type": "String",
      "Default": "",
      "Description": "Leave empty for initial data deployment; update with the exact CloudFront distribution ARN after creating the edge stack. This stack remains the sole media-bucket policy owner.",
      "AllowedPattern": "^$|^arn:aws(?:-cn|-us-gov)?:cloudfront::[0-9]{12}:distribution/[A-Z0-9]+$"
    }
  },
  "Conditions": {
    "HighAvailability": {
      "Fn::Equals": [
        {
          "Ref": "MultiAZ"
        },
        "true"
      ]
    },
    "HasMediaDistribution": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "MediaDistributionArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "MySQL from Waithaka application instances only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3306,
            "ToPort": 3306,
            "SourceSecurityGroupId": {
              "Ref": "ApplicationSecurityGroupId"
            }
          }
        ]
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private database subnets",
        "SubnetIds": {
          "Ref": "PrivateSubnetIds"
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "Engine": "mysql",
        "EngineVersion": {
          "Ref": "DatabaseEngineVersion"
        },
        "DBName": {
          "Ref": "DatabaseName"
        },
        "DBInstanceClass": {
          "Ref": "DatabaseClass"
        },
        "AllocatedStorage": "20",
        "MaxAllocatedStorage": 100,
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MasterUsername": "wk_restore_admin",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "PubliclyAccessible": false,
        "MultiAZ": {
          "Fn::If": [
            "HighAvailability",
            true,
            false
          ]
        },
        "BackupRetentionPeriod": 14,
        "CopyTagsToSnapshot": true,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "EnableCloudwatchLogsExports": [
          "error",
          "slowquery"
        ]
      }
    },
    "PublicMedia": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "PublicMediaTlsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "PublicMedia"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "PublicMedia",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${PublicMedia.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Fn::If": [
                "HasMediaDistribution",
                {
                  "Sid": "CloudFrontMediaRead",
                  "Effect": "Allow",
                  "Principal": {
                    "Service": "cloudfront.amazonaws.com"
                  },
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${PublicMedia.Arn}/assets/uploads/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "AWS:SourceArn": {
                        "Ref": "MediaDistributionArn"
                      }
                    }
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      }
    },
    "PrivateMedia": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "PrivateMediaTlsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "PrivateMedia"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "PrivateMedia",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${PrivateMedia.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ReleaseArtifacts": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "ReleaseArtifactsTlsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ReleaseArtifacts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ReleaseArtifacts",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ReleaseArtifacts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "DatabaseHost": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "AdminSecretArn": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "MasterUserSecret.SecretArn"
        ]
      },
      "Description": "Restore/admin only. Create a separate least-privilege runtime database account."
    },
    "PublicMedia": {
      "Value": {
        "Ref": "PublicMedia"
      }
    },
    "PrivateMedia": {
      "Value": {
        "Ref": "PrivateMedia"
      }
    },
    "ReleaseArtifacts": {
      "Value": {
        "Ref": "ReleaseArtifacts"
      }
    }
  }
}
